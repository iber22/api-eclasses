# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# (Supabase > Project Settings > API)

# "Project URL"
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave SECRETA: "service_role" (ou "secret key", nas contas novas).
# NUNCA use a chave "anon/publishable" aqui e NUNCA coloque esta chave no front
# ou no GitHub: ela ignora todas as regras de segurança do banco.
SUPABASE_KEY=cole-aqui-a-chave-service-role

# Opcionais
PORT=3000
# Origem permitida pelo CORS. Em produção, coloque a URL do seu front.
CORS_ORIGIN=*
